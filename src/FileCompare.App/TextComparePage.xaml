<tabs:PathComparePage x:Class="FileCompare.App.TextComparePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:tabs="clr-namespace:FileCompare.App.Tabs"
        PreviewKeyDown="OnPageKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource App.Surface}">
            <MenuItem Header="_File">
                <MenuItem Header="_New tab" InputGestureText="Ctrl+T" Click="OnNewTabClick"/>
                <MenuItem Header="_Home" Click="OnHomeClick"/>
                <MenuItem Header="Recen_t" SubmenuOpened="OnRecentMenuOpened">
                    <MenuItem Header="(none yet)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Save as se_ssion..." Click="OnSaveSessionClick"/>
                <Separator/>
                <MenuItem Header="Save _Left" Click="OnSaveLeft"/>
                <MenuItem Header="Save _Right" Click="OnSaveRight"/>
                <MenuItem Header="_Save All" InputGestureText="Ctrl+S" Click="OnSaveAll"/>
                <Separator/>
                <MenuItem Header="Re_load from disk" InputGestureText="F5" Click="OnReload"/>
                <Separator/>
                <MenuItem Header="_Close tab" InputGestureText="Ctrl+W" Click="OnCloseTabClick"/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edit" SubmenuOpened="OnEditMenuOpened">
                <MenuItem x:Name="UndoItem" Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo"/>
                <MenuItem x:Name="RedoItem" Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo"/>
                <Separator/>
                <MenuItem Header="Update _differences now" InputGestureText="F6" Click="OnUpdateDifferencesNow"/>
                <Separator/>
                <MenuItem Header="Copy section to _right" Click="OnCopyToRight"/>
                <MenuItem Header="Copy section to _left" Click="OnCopyToLeft"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ThemeMenu" Header="_Theme"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Rules..." Click="OnRules"/>
                <MenuItem Header="_Format..." Click="OnFormat"/>
                <Separator/>
                <MenuItem Header="_Explorer integration..." Click="OnShellIntegration"/>
            </MenuItem>
            <MenuItem Header="_About" Click="OnAbout"
                      ToolTip="About File Compare: version, source code, changelog, license"/>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: home and sessions, view filters, rules and format, copy and edit, navigation, swap and reload, theme -->
            <ToolBar Grid.Row="0" Background="{DynamicResource App.Surface}">
                <Button Content="Home" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Home}"
                        ToolTip="Home: recent comparisons and saved sessions" Click="OnHomeClick"/>
                <Button Content="Sessions" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Sessions}"
                        ToolTip="Save this comparison, or open a saved or recent one" Click="OnSessionsButtonClick"/>
                <Separator/>
                <RadioButton x:Name="ViewAllButton" GroupName="ViewMode" IsChecked="True" Content="All"
                             Style="{StaticResource IconRadioButton}" Tag="{StaticResource Icon.All}"
                             ToolTip="Show every line" Checked="OnViewModeChecked"/>
                <RadioButton x:Name="ViewDiffsButton" GroupName="ViewMode" Content="Diffs"
                             Style="{StaticResource IconRadioButton}" Tag="{StaticResource Icon.Diffs}"
                             ToolTip="Show only the differences" Checked="OnViewModeChecked"/>
                <RadioButton x:Name="ViewSameButton" GroupName="ViewMode" Content="Same"
                             Style="{StaticResource IconRadioButton}" Tag="{StaticResource Icon.Same}"
                             ToolTip="Show only the lines that are the same" Checked="OnViewModeChecked"/>
                <Separator/>
                <RadioButton x:Name="ViewContextButton" GroupName="ViewMode" Content="Context"
                             Style="{StaticResource IconRadioButton}" Tag="{StaticResource Icon.Context}"
                             ToolTip="Show the differences with a few lines around them" Checked="OnViewModeChecked"/>
                <ToggleButton x:Name="MinorToggle" Content="Minor" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.Minor}"
                              ToolTip="Show lines that differ only in unimportant ways (see Rules)" Checked="OnMinorChanged" Unchecked="OnMinorChanged"/>
                <Separator/>
                <Button Content="Rules" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Rules}"
                        ToolTip="Choose which differences are unimportant" Click="OnRules"/>
                <Button Content="Format" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Format}"
                        ToolTip="Encoding, tab size and visible whitespace" Click="OnFormat"/>
                <Separator/>
                <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Copy}"
                        ToolTip="Copy the current difference to the other side" Click="OnCopyButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CopyMenu">
                            <MenuItem Header="Copy to right  →" Click="OnCopyToRight"/>
                            <MenuItem Header="←  Copy to left" Click="OnCopyToLeft"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton x:Name="EditToggle" Content="Edit" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.Edit}" ToolTip="Edit the files (Save with Ctrl+S)" Checked="OnEditChanged" Unchecked="OnEditChanged"/>
                <Separator/>
                <Button x:Name="NextButton" Content="Next Section" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.NextSection}" ToolTip="Go to the next difference" Click="OnNextSection"/>
                <Button x:Name="PrevButton" Content="Prev Section" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.PrevSection}" ToolTip="Go to the previous difference" Click="OnPrevSection"/>
                <Separator/>
                <Button Content="Swap" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.Swap}" ToolTip="Swap left and right" Click="OnSwap"/>
                <Button Content="Reload" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.Reload}" ToolTip="Reload both files from disk (F5)" Click="OnReload"/>
                <Separator/>
                <Button x:Name="ThemeButton" Content="Theme" Style="{StaticResource IconButton}"
                        Tag="{StaticResource Icon.Theme}" ToolTip="Choose a color theme" Click="OnThemeButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeButtonMenu"/>
                    </Button.ContextMenu>
                </Button>
            </ToolBar>

            <!-- Path bars (files can be dropped here) -->
            <Grid Grid.Row="1" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <Button DockPanel.Dock="Right" Content="..." Width="28" ToolTip="Choose a file" Click="OnBrowseLeft"/>
                    <TextBox x:Name="LeftPath" Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                             KeyDown="OnPathKeyDown" VerticalContentAlignment="Center" ToolTip="Left file. Type a path and press Enter, or drop a file here."/>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <Button DockPanel.Dock="Right" Content="..." Width="28" ToolTip="Choose a file" Click="OnBrowseRight"/>
                    <TextBox x:Name="RightPath" Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                             KeyDown="OnPathKeyDown" VerticalContentAlignment="Center" ToolTip="Right file. Type a path and press Enter, or drop a file here."/>
                </DockPanel>
            </Grid>

            <!-- Info bars -->
            <Grid Grid.Row="2" Margin="4,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftInfo" Grid.Column="0" Foreground="{DynamicResource App.TextSecondary}"/>
                <TextBlock x:Name="RightInfo" Grid.Column="2" Foreground="{DynamicResource App.TextSecondary}"/>
            </Grid>

            <!-- Editors -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ae:TextEditor x:Name="LeftEditor" Grid.Column="0" IsReadOnly="True"
                               FontFamily="Consolas" FontSize="13" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
                <ae:TextEditor x:Name="RightEditor" Grid.Column="2" IsReadOnly="True"
                               FontFamily="Consolas" FontSize="13" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Status bar -->
            <StatusBar Grid.Row="4" Background="{DynamicResource App.Surface}">
                <StatusBarItem><TextBlock x:Name="DiffCountText" Text="Ready"/></StatusBarItem>
                <Separator/>
                <StatusBarItem><TextBlock x:Name="SameText"/></StatusBarItem>
                <Separator/>
                <StatusBarItem><TextBlock x:Name="ModeText"/></StatusBarItem>
                <Separator/>
                <StatusBarItem><TextBlock x:Name="LoadTimeText"/></StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</tabs:PathComparePage>