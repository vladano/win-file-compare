<Window x:Class="FileCompare.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About File Compare"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}">
    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Source="pack://application:,,,/FileCompare;component/icon.ico"
               Width="64" Height="64" VerticalAlignment="Top" Margin="0,2,18,0"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="File Compare icon"/>

        <StackPanel Grid.Column="1" MinWidth="360">
            <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,2,0,0" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock x:Name="DescriptionText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="380"/>
            <TextBlock x:Name="TaglineText" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"/>
            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="380"
                       Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock x:Name="BuiltWithText" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"
                       Foreground="{DynamicResource App.TextSecondary}"/>

            <!-- Links open in the default browser. -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="RepositoryLink" RequestNavigate="OnLinkRequestNavigate">Source code on GitHub</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="RepositoryUrlText" Margin="0,0,0,4" FontSize="11"
                           Foreground="{DynamicResource App.TextSecondary}"/>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="ReadmeLink" RequestNavigate="OnLinkRequestNavigate">Features and how to use it (README)</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="ChangelogLink" RequestNavigate="OnLinkRequestNavigate">What's new (changelog)</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="ReleasesLink" RequestNavigate="OnLinkRequestNavigate">Check for a newer version</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="IssuesLink" RequestNavigate="OnLinkRequestNavigate">Report a problem or suggest an idea</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="LicenseLink" RequestNavigate="OnLinkRequestNavigate">
                        <Run x:Name="LicenseRun"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Padding="12,3" Click="OnCopyClick"
                    ToolTip="Copy the version and Windows details, for example for a bug report"/>
            <Button Content="Close" Padding="18,3" Margin="8,0,0,0" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
