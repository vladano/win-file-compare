<Window x:Class="FileCompare.App.Dialogs.SyncPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Width="860" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}">
    <DockPanel Margin="18">
        <!-- What the operation does, and from where to where -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock x:Name="RootsText" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="11"
                       Foreground="{DynamicResource App.TextSecondary}"/>
        </StackPanel>

        <!-- Totals and buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RunButton" MinWidth="110" Padding="12,4" IsDefault="True" Click="OnRun"/>
                <Button Content="Cancel" MinWidth="84" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TotalsText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource App.TextSecondary}"/>
            </StackPanel>
        </DockPanel>

        <!-- The planned actions, grouped by kind -->
        <ListView x:Name="ItemsList" Margin="0,12,0,0" SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" KeyDown="OnListKeyDown"
                  Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                  AutomationProperties.Name="Planned actions">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,10,0,4" FontWeight="SemiBold">
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource App.TextSecondary}"/>
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding CanInclude}"
                                          AutomationProperties.Name="{Binding Path}" ToolTip="Leave this item out, or put it back"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Path" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Why" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Do" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Choice}" Visibility="{Binding ChoiceVisibility}"
                                          IsEnabled="{Binding CanChoose}" MinWidth="100"
                                          AutomationProperties.Name="{Binding Path, StringFormat=What to do with {0}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
