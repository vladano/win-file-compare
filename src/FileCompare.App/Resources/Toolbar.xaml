<!--
  Toolbar button styles: icon on top, label below (like the reference layout).
  Set the icon with Tag="{StaticResource Icon.Xxx}" and the label with Content.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default for themes that do not define their own colors (works on light and dark). -->
    <SolidColorBrush x:Key="App.TextSecondary" Color="#808080"/>

    <DataTemplate x:Key="IconOverLabelTemplate">
        <StackPanel Orientation="Vertical" MinWidth="40">
            <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                   Width="24" Height="24" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11"
                       Foreground="{DynamicResource App.Text}"/>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="IconButton" TargetType="Button"
           BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconOverLabelTemplate}"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>

    <Style x:Key="IconRadioButton" TargetType="RadioButton"
           BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconOverLabelTemplate}"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>

    <Style x:Key="IconToggleButton" TargetType="ToggleButton"
           BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconOverLabelTemplate}"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>
</ResourceDictionary>
