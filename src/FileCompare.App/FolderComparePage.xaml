<tabs:PathComparePage x:Class="FileCompare.App.FolderComparePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:FileCompare.App.Tabs"
        PreviewKeyDown="OnPageKeyDown">
    <tabs:PathComparePage.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </tabs:PathComparePage.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource App.Surface}">
            <MenuItem Header="_File">
                <MenuItem Header="_New tab" InputGestureText="Ctrl+T" Click="OnNewTabClick"/>
                <MenuItem Header="_Home" Click="OnHomeClick"/>
                <MenuItem Header="Recen_t" SubmenuOpened="OnRecentMenuOpened">
                    <MenuItem Header="(none yet)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Save as se_ssion..." Click="OnSaveSessionClick"/>
                <Separator/>
                <MenuItem Header="_Reload" InputGestureText="F5" Click="OnReload"/>
                <Separator/>
                <MenuItem Header="_Close tab" InputGestureText="Ctrl+W" Click="OnCloseTabClick"/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem Header="_Open" InputGestureText="Enter" Click="OnOpen"/>
                <Separator/>
                <MenuItem Header="Copy to _right" Click="OnCopyToRight"/>
                <MenuItem Header="Copy to _left" Click="OnCopyToLeft"/>
                <MenuItem Header="Delete from le_ft" Click="OnDeleteLeft"/>
                <MenuItem Header="Delete from ri_ght" Click="OnDeleteRight"/>
                <Separator/>
                <MenuItem Header="Update right (copy new and newer files)..." Click="OnUpdateRight"/>
                <MenuItem Header="Update left (copy new and newer files)..." Click="OnUpdateLeft"/>
                <MenuItem Header="_Mirror to right (with deletes)..." Click="OnMirrorRight"/>
                <MenuItem Header="Mirror _to left (with deletes)..." Click="OnMirrorLeft"/>
                <MenuItem Header="_Sync both ways..." Click="OnSyncBothWays"/>
                <Separator/>
                <MenuItem Header="_Expand all" Click="OnExpandAll"/>
                <MenuItem Header="_Collapse all" Click="OnCollapseAll"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ThemeMenu" Header="_Theme"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Rules..." Click="OnRules"/>
                <Separator/>
                <MenuItem Header="_Explorer integration..." Click="OnShellIntegration"/>
            </MenuItem>
            <MenuItem Header="_About" Click="OnAbout"
                      ToolTip="About File Compare: version, source code, changelog, license"/>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ToolBar Grid.Row="0" Background="{DynamicResource App.Surface}">
                <Button Content="Home" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Home}"
                        ToolTip="Home: recent comparisons and saved sessions" Click="OnHomeClick"/>
                <Button Content="Sessions" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Sessions}"
                        ToolTip="Save this comparison, or open a saved or recent one" Click="OnSessionsButtonClick"/>
                <Separator/>
                <ToggleButton x:Name="ShowDifferentButton" IsChecked="True" Content="Different" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.Diffs}" ToolTip="Show files that differ"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <ToggleButton x:Name="ShowLeftOnlyButton" IsChecked="True" Content="Left only" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.LeftOnly}" ToolTip="Show entries that exist only on the left"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <ToggleButton x:Name="ShowRightOnlyButton" IsChecked="True" Content="Right only" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.RightOnly}" ToolTip="Show entries that exist only on the right"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <ToggleButton x:Name="ShowSameButton" IsChecked="True" Content="Same" Style="{StaticResource IconToggleButton}"
                              Tag="{StaticResource Icon.Same}" ToolTip="Show files that are the same"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <Separator/>
                <Button Content="Expand" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Expand}"
                        ToolTip="Open every folder" Click="OnExpandAll"/>
                <Button Content="Collapse" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Collapse}"
                        ToolTip="Close every folder" Click="OnCollapseAll"/>
                <Button Content="Rules" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Rules}"
                        ToolTip="Ignored names and how files are compared" Click="OnRules"/>
                <Separator/>
                <Button Content="Open" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Open}"
                        ToolTip="Compare the selected file in a new tab (or open the folder)" Click="OnOpen"/>
                <Button Content="Copy right" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.CopyRight}"
                        ToolTip="Copy the selected entries to the right side" Click="OnCopyToRight"/>
                <Button Content="Copy left" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.CopyLeft}"
                        ToolTip="Copy the selected entries to the left side" Click="OnCopyToLeft"/>
                <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Delete}"
                        ToolTip="Delete the selected entries from one side (Recycle Bin)" Click="OnDeleteButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="DeleteMenu">
                            <MenuItem Header="Delete from left" Click="OnDeleteLeft"/>
                            <MenuItem Header="Delete from right" Click="OnDeleteRight"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="UpdateButton" Content="Sync" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Update}"
                        ToolTip="Update, mirror or sync the two folders. A preview shows every change first." Click="OnUpdateButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="UpdateMenu">
                            <MenuItem Header="Update right" Click="OnUpdateRight" ToolTip="Copy new and newer files to the right. Nothing is deleted."/>
                            <MenuItem Header="Update left" Click="OnUpdateLeft" ToolTip="Copy new and newer files to the left. Nothing is deleted."/>
                            <Separator/>
                            <MenuItem Header="Mirror to right" Click="OnMirrorRight" ToolTip="Make the right an exact copy of the left, with deletes"/>
                            <MenuItem Header="Mirror to left" Click="OnMirrorLeft" ToolTip="Make the left an exact copy of the right, with deletes"/>
                            <Separator/>
                            <MenuItem Header="Sync both ways" Click="OnSyncBothWays" ToolTip="Bring the changes made on each side since the last sync to the other side"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Separator/>
                <Button Content="Swap" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Swap}"
                        ToolTip="Swap left and right" Click="OnSwap"/>
                <Button Content="Reload" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Reload}"
                        ToolTip="Scan both folders again (F5)" Click="OnReload"/>
                <Separator/>
                <Button x:Name="ThemeButton" Content="Theme" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Theme}"
                        ToolTip="Choose a color theme" Click="OnThemeButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeButtonMenu"/>
                    </Button.ContextMenu>
                </Button>
            </ToolBar>

            <Grid Grid.Row="1" Margin="4,4,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <Button DockPanel.Dock="Right" Content="..." Width="28" ToolTip="Choose a folder" Click="OnBrowseLeft"/>
                    <TextBox x:Name="LeftPath" Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                             KeyDown="OnPathKeyDown" VerticalContentAlignment="Center" ToolTip="Left folder. Type a path and press Enter, or drop a folder here."/>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <Button DockPanel.Dock="Right" Content="..." Width="28" ToolTip="Choose a folder" Click="OnBrowseRight"/>
                    <TextBox x:Name="RightPath" Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                             KeyDown="OnPathKeyDown" VerticalContentAlignment="Center" ToolTip="Right folder. Type a path and press Enter, or drop a folder here."/>
                </DockPanel>
            </Grid>

            <DataGrid x:Name="FolderGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                      EnableRowVirtualization="True" RowHeaderWidth="0" BorderThickness="0"
                      Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}"
                      MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKeyDown">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Background" Value="{Binding RowBrush}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Expander}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Width="16" VerticalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               MouseLeftButtonDown="OnExpanderClick"/>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Margin="2,0,6,0" VerticalAlignment="Center"
                                               Foreground="{Binding GlyphBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size (left)" Binding="{Binding LeftSize}" Width="90"
                                        ElementStyle="{StaticResource CellTextRight}"/>
                    <DataGridTextColumn Header="Modified (left)" Binding="{Binding LeftDate}" Width="150"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Size (right)" Binding="{Binding RightSize}" Width="90"
                                        ElementStyle="{StaticResource CellTextRight}"/>
                    <DataGridTextColumn Header="Modified (right)" Binding="{Binding RightDate}" Width="150"
                                        ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StatusBar Grid.Row="3" Background="{DynamicResource App.Surface}">
                <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
                <Separator/>
                <StatusBarItem><TextBlock x:Name="SummaryText"/></StatusBarItem>
                <Separator/>
                <StatusBarItem><TextBlock x:Name="TimeText"/></StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</tabs:PathComparePage>