<Window x:Class="FileCompare.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Compare" Width="1300" Height="800" Icon="icon.ico"
        Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}"
        PreviewKeyDown="OnWindowKeyDown" Closing="OnWindowClosing">
    <Window.Resources>
        <!-- A flat tab look that follows the theme colors. -->
        <Style x:Key="TabStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                Padding="12,6,4,6" Margin="0,0,1,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Control}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Background}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource App.Surface}">
            <Button DockPanel.Dock="Right" Content="&#xE710;" FontSize="12" Padding="10,6" Margin="0,0,6,0"
                    Style="{StaticResource TabButton}" ToolTip="New tab (Ctrl+T)" Click="OnNewTabClick"
                    AutomationProperties.Name="New tab"/>
            <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource TabStyle}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Tabs">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Page.Title}"
                                    MouseDown="OnTabMouseDown">
                            <TextBlock Text="{Binding Page.Header}" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Content="&#xE711;" FontSize="9" Padding="5,3" Margin="8,0,0,0"
                                    Style="{StaticResource TabButton}" ToolTip="Close tab (Ctrl+W)" Click="OnTabCloseClick"
                                    AutomationProperties.Name="Close tab"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="PageHost" Focusable="False" Content="{Binding SelectedItem.Page, ElementName=TabStrip}"/>
    </DockPanel>
</Window>
