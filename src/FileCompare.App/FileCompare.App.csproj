<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\FileCompare.Core\FileCompare.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileCompare</AssemblyName>
    <RootNamespace>FileCompare.App</RootNamespace>
    <!-- Icon used for the exe, shortcuts and the taskbar. Generated by scripts/generate-icon.ps1 -->
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
    <Product>File Compare</Product>
    <Version>1.0.0</Version>
    <Authors>vladano</Authors>
    <Copyright>Copyright (c) 2026 vladano</Copyright>
    <RepositoryUrl>https://github.com/vladano/win-file-compare</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embedded so the window icon can be set in XAML. -->
    <Resource Include="..\..\build\icon.ico" Link="icon.ico" />
  </ItemGroup>
</Project>
